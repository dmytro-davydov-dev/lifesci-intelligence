# Copy to .env and adjust locally. Never commit .env.
POSTGRES_USER=lifesci
# Demo-only default; use URL-safe characters (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=lifesci
POSTGRES_DB=lifesci

# fake = deterministic offline providers (no key needed); openai = real models (requires OPENAI_API_KEY)
MODEL_PROVIDER=fake
OPENAI_API_KEY=
# Required when MODEL_PROVIDER=openai (no default); embeddings use text-embedding-3-small
OPENAI_CHAT_MODEL=
# Output cap per answer (includes reasoning tokens for reasoning models)
MAX_OUTPUT_TOKENS=1000
# Wall-clock budget per chat request (embedding + model calls); exceeded -> HTTP 504
REQUEST_DEADLINE_SECONDS=45
# vector = cosine only; hybrid = cosine + full-text fused with RRF
RETRIEVAL_MODE=hybrid
LOG_LEVEL=INFO

# Optional LangSmith tracing (off by default; metadata-only payloads unless TRACE_INCLUDE_CONTENT=true)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lifesci-intelligence
# Only for approved public/synthetic documents
TRACE_INCLUDE_CONTENT=false

# Browser-visible API base URL (baked into the web image at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
