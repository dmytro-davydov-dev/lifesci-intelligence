# Copy to .env and adjust locally. Never commit .env.
POSTGRES_USER=lifesci
# Demo-only default; use URL-safe characters (it is embedded in DATABASE_URL).
POSTGRES_PASSWORD=lifesci
POSTGRES_DB=lifesci

# fake = deterministic offline providers (no key needed); openai = real models (requires OPENAI_API_KEY)
MODEL_PROVIDER=fake
OPENAI_API_KEY=

# Browser-visible API base URL (baked into the web image at build time)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
